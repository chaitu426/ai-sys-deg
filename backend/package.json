{
  "name": "system-design-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade System Design Intelligence Platform",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "prepare": "husky",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "prisma generate"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^1.38.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.19.1",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.4.0",
    "cheerio": "^1.0.0-rc.12",
    "dodopayments": "^2.17.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.7.2",
    "fastify-raw-body": "^5.0.0",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.3.2",
    "prisma": "^5.19.1",
    "resend": "^6.9.1",
    "user-agents": "^1.1.669",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.3",
    "@types/user-agents": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}